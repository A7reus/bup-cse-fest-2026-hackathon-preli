# Copy to .env and fill in — never commit .env
# Tier 1 (primary)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Tier 2 (fallback, separate per-model quota)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Chain order (comma-separated subset of groq, gemini-lite).
# Use a single name for isolated per-model testing, e.g. gemini-lite.
GRIDWISE_LLM_CHAIN=groq,gemini-lite
LLM_TIMEOUT_MS=20000
LLM_MAX_ATTEMPTS=2
PORT=8080
HOST=0.0.0.0
# Optional custom OpenAI-compatible base URLs (gateway/proxy).
LLM_BASE_URL=
GEMINI_BASE_URL=
# Set to 1 to bypass all LLM tiers (quota-free local testing only).
GRIDWISE_FORCE_FALLBACK=0
