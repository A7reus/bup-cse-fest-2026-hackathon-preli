# Copy to .env and fill in — never commit .env
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_MS=20000
LLM_MAX_ATTEMPTS=2
PORT=8080
HOST=0.0.0.0
# Optional custom OpenAI-compatible base URL (gateway/proxy). Defaults to Groq.
LLM_BASE_URL=
# Set to 1 to bypass the LLM entirely (quota-free local testing only).
GRIDWISE_FORCE_FALLBACK=0
